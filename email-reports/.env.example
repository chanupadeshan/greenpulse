# Copy this file to email-reports/.env.
# Weather settings can also come from the project-root .env.
GREENHOUSE_LATITUDE=
GREENHOUSE_LONGITUDE=
OPENWEATHER_API_KEY=

EMAIL_TO=your-address@gmail.com
EMAIL_INTERVAL_SECONDS=300
GREENPULSE_API_URL=http://127.0.0.1:8010

# Paths are relative to email-reports/.
# Leave blank to find credentials.json or a single downloaded client_secret_*.json.
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=token.json
# For a Web application OAuth client, add this exact URI in Google Cloud.
GMAIL_REDIRECT_URI=http://localhost:8080/
