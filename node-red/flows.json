[
    {
        "id": "greenpulse-flow",
        "type": "tab",
        "label": "GreenPulse live agents",
        "disabled": false,
        "info": "Prediction refreshes continuously. The separate AI assistant answers submitted questions only. Secrets stay in Python."
    },
    {
        "id": "gp-base",
        "type": "ui-base",
        "name": "GreenPulse",
        "path": "/dashboard",
        "appIcon": "mdi-sprout",
        "includeClientData": true,
        "acceptsClientConfig": [
            "ui-notification",
            "ui-control",
            "ui-template"
        ],
        "showPathInSidebar": false,
        "headerContent": "page",
        "navigationStyle": "none",
        "titleBarStyle": "hidden"
    },
    {
        "id": "gp-theme",
        "type": "ui-theme",
        "name": "GreenPulse light",
        "colors": {
            "surface": "#f6f8f5",
            "primary": "#217454",
            "bgPage": "#f6f8f5",
            "groupBg": "#f6f8f5",
            "groupOutline": "#f6f8f5"
        },
        "sizes": {
            "density": "default",
            "pagePadding": "0px",
            "groupGap": "0px",
            "groupBorderRadius": "0px",
            "widgetGap": "0px"
        }
    },
    {
        "id": "gp-page",
        "type": "ui-page",
        "name": "Greenhouse",
        "ui": "gp-base",
        "path": "/greenhouse",
        "icon": "mdi-sprout",
        "layout": "grid",
        "theme": "gp-theme",
        "order": 1,
        "visible": true,
        "disabled": false,
        "breakpoints": [
            {
                "name": "Default",
                "px": "0",
                "cols": "12"
            },
            {
                "name": "Tablet",
                "px": "576",
                "cols": "12"
            },
            {
                "name": "Small Desktop",
                "px": "768",
                "cols": "12"
            },
            {
                "name": "Desktop",
                "px": "1024",
                "cols": "12"
            }
        ]
    },
    {
        "id": "gp-group",
        "type": "ui-group",
        "name": "Greenhouse intelligence",
        "page": "gp-page",
        "width": "12",
        "height": "1",
        "order": 1,
        "showTitle": false,
        "visible": true,
        "disabled": false
    },
    {
        "id": "gp-ai-page",
        "type": "ui-page",
        "name": "AI assistant",
        "ui": "gp-base",
        "path": "/assistant",
        "icon": "mdi-chat",
        "layout": "grid",
        "theme": "gp-theme",
        "order": 2,
        "visible": true,
        "disabled": false,
        "breakpoints": [
            {
                "name": "Default",
                "px": "0",
                "cols": "12"
            },
            {
                "name": "Tablet",
                "px": "576",
                "cols": "12"
            },
            {
                "name": "Small Desktop",
                "px": "768",
                "cols": "12"
            },
            {
                "name": "Desktop",
                "px": "1024",
                "cols": "12"
            }
        ]
    },
    {
        "id": "gp-ai-group",
        "type": "ui-group",
        "name": "Plant conversation",
        "page": "gp-ai-page",
        "width": "12",
        "height": "1",
        "order": 1,
        "showTitle": false,
        "visible": true,
        "disabled": false
    },
    {
        "id": "gp-poll",
        "type": "inject",
        "z": "greenpulse-flow",
        "name": "Poll status every 5 sec",
        "x": 170,
        "y": 100,
        "wires": [
            [
                "gp-status-url"
            ]
        ],
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "payload": "",
        "payloadType": "date"
    },
    {
        "id": "gp-status-url",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "GET backend status",
        "x": 410,
        "y": 100,
        "wires": [
            [
                "gp-get"
            ]
        ],
        "outputs": 1,
        "func": "msg.url = (env.get(\"GREENPULSE_API_URL\") || \"http://127.0.0.1:8010\") + \"/api/status\";\nmsg.method = \"GET\"; delete msg.payload; return msg;"
    },
    {
        "id": "gp-get",
        "type": "http request",
        "z": "greenpulse-flow",
        "name": "Read live state",
        "x": 640,
        "y": 100,
        "wires": [
            [
                "gp-status-format"
            ]
        ],
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "senderr": false,
        "headers": [],
        "requestTimeout": "15000"
    },
    {
        "id": "gp-status-format",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "Status / offline",
        "x": 870,
        "y": 100,
        "wires": [
            [
                "gp-dashboard",
                "gp-assistant"
            ]
        ],
        "outputs": 1,
        "func": "if(msg.statusCode === 200 && msg.payload && msg.payload.config) { msg.topic=\"status\"; delete msg._client; return msg; }\nmsg.topic=\"request-error\"; msg.payload={error:\"Backend unavailable. Check the API process.\",disconnected:true}; return msg;"
    },
    {
        "id": "gp-dashboard",
        "type": "ui-template",
        "z": "greenpulse-flow",
        "name": "GreenPulse dashboard",
        "x": 1100,
        "y": 200,
        "wires": [
            [
                "gp-run-url"
            ]
        ],
        "group": "gp-group",
        "page": "",
        "ui": "",
        "order": 1,
        "width": "12",
        "height": "0",
        "head": "",
        "format": "<template>\n  <main class=\"gp-shell\">\n    <header class=\"gp-heading\">\n      <div><div class=\"gp-eyebrow\">GREENPULSE / GREENHOUSE INTELLIGENCE</div><h1>Continuous prediction.</h1><p>Stored DynamoDB readings, sensor trends, and model results updated automatically.</p></div>\n      <span class=\"gp-pill\" :class=\"connected ? 'gp-green' : 'gp-amber'\">{{ connected ? 'Backend connected' : 'Waiting for backend' }}</span>\n    </header>\n    <nav class=\"gp-tabs\" aria-label=\"Dashboard tabs\"><a class=\"gp-tab-active\" href=\"/dashboard/greenhouse\" aria-current=\"page\">Prediction</a><a href=\"/dashboard/assistant\">AI assistant</a></nav>\n    <div class=\"gp-toolbar\">\n      <div><strong>{{ config.device_id || 'Configure device ID' }}</strong><span>{{ config.region }} · {{ config.table }}</span></div>\n      <div class=\"gp-buttons\"><button @click=\"run('prediction')\" :disabled=\"busy || !connected\">Refresh prediction</button></div>\n    </div>\n    <div v-if=\"notice\" class=\"gp-alert\" role=\"status\">{{ notice }}</div>\n    <div v-if=\"config.demo\" class=\"gp-alert\"><strong>DEMO MODE</strong> — simulated sensors and weather with the real trained model. AWS, OpenWeather, and Groq are not called.</div>\n    <div v-if=\"!connected\" class=\"gp-alert\">Start the GreenPulse backend to load readings. Waiting for a successful status response.</div>\n    <div v-if=\"sensor.status === 'error'\" class=\"gp-alert\">{{ sensor.error }}</div>\n    <div v-if=\"sensor.warnings?.length\" class=\"gp-alert\"><strong>Measurement checks</strong><ul><li v-for=\"w in sensor.warnings\" :key=\"w\">{{ w }}</li></ul></div>\n    <section class=\"gp-grid gp-metrics\" aria-label=\"Latest sensor readings\">\n      <article v-for=\"metric in metrics\" :key=\"metric.key\" class=\"gp-card\">\n        <div class=\"gp-label\">{{ metric.label }}</div><div class=\"gp-value\">{{ sensorValue(latest[metric.key]) }}<small v-if=\"latest[metric.key] != null\">{{ metric.unit }}</small></div>\n        <div class=\"gp-subtle\">{{ latest[metric.key] == null ? 'Measurement unavailable' : 'Stored device measurement' }}</div>\n      </article>\n    </section>\n    <div class=\"gp-meta\">Latest reading: {{ date(latest.timestamp) }} <span v-if=\"sensor.age_minutes != null\"> · {{ Math.round(sensor.age_minutes) }} minutes old</span> · {{ sensor.row_count || 0 }} recent readings</div>\n    <section class=\"gp-grid gp-two\">\n      <article class=\"gp-card gp-prediction\">\n        <div class=\"gp-card-heading\"><h2>Model prediction</h2><span class=\"gp-pill\" :class=\"ml.status === 'ok' ? severityClass : 'gp-amber'\">{{ ml.status === 'ok' ? (ml.is_anomaly ? ml.severity + ' severity' : 'Normal') : (ml.status || 'Waiting') }}</span></div>\n        <div class=\"gp-result\" :class=\"ml.status === 'ok' ? severityClass + '-text' : ''\">{{ ml.status === 'ok' ? (ml.is_anomaly ? 'Unusual sensor pattern' : 'Normal sensor pattern') : 'Prediction unavailable' }}</div>\n        <p v-if=\"ml.status !== 'ok'\">{{ ml.error || 'Waiting for the first reading.' }}</p>\n        <div v-if=\"ml.status === 'ok'\" class=\"gp-score\"><div><span>ANOMALY SCORE</span><strong>{{ number(ml.score) }}</strong></div><div><span>ACTIVE THRESHOLD</span><strong>{{ number(ml.threshold) }}</strong></div><div><span>SEVERITY</span><strong :class=\"severityClass + '-text'\">{{ ml.severity }}</strong></div></div>\n        <div v-if=\"ml.status === 'ok'\" class=\"gp-meter\" :class=\"severityClass + '-meter'\" role=\"img\" :aria-label=\"ml.severity + ' severity; score ' + number(ml.score) + ', threshold ' + number(ml.threshold)\"><div :style=\"{width: Math.max(0, Math.min(100, ml.score / Math.max(ml.threshold * 2, 0.000001) * 100)) + '%'}\"></div><span></span></div>\n      </article>\n      <article class=\"gp-card\">\n        <div class=\"gp-card-heading\"><h2>Recent sensor trends</h2><select v-model=\"trend\" aria-label=\"Select trend\"><option value=\"air_temp_c\">Air temperature</option><option value=\"humidity\">Humidity</option><option value=\"soil_moisture_l1\">Moisture · layer 1</option><option value=\"soil_moisture_l2\">Moisture · layer 2</option><option value=\"soil_temp_l1_c\">Soil temperature · layer 1</option><option value=\"soil_temp_l2_c\">Soil temperature · layer 2</option></select></div>\n        <div v-if=\"chartPoints.length\" class=\"gp-chart\"><div class=\"gp-chart-scale\"><span>{{ chartMax.toFixed(1) }}</span><span>{{ chartMin.toFixed(1) }}</span></div><svg viewBox=\"0 0 600 140\" preserveAspectRatio=\"none\" role=\"img\" :aria-label=\"'Recent ' + trend + ' trend'\"><line x1=\"0\" y1=\"139\" x2=\"600\" y2=\"139\" stroke=\"#d9e6df\"/><polyline :points=\"chartLine\" fill=\"none\" stroke=\"#217454\" stroke-width=\"3\" vector-effect=\"non-scaling-stroke\"/><circle v-for=\"p in chartPoints\" :key=\"p.x\" :cx=\"p.x\" :cy=\"p.y\" r=\"3\" fill=\"#217454\"/></svg></div>\n        <p v-else class=\"gp-empty\">No measured values for this sensor yet.</p>\n        <div class=\"gp-chart-dates\"><span>{{ date(sensor.readings?.[0]?.timestamp) }}</span><span>{{ date(latest.timestamp) }}</span></div>\n        <p class=\"gp-subtle\">Most recent device records, ordered by timestamp. Null readings break the line.</p>\n      </article>\n    </section>\n    <section class=\"gp-card gp-history\"><h2>Run history</h2><div class=\"gp-table-scroll\"><table><thead><tr><th>Completed</th><th>Workflow</th><th>Result</th><th>Run ID</th></tr></thead><tbody><tr v-for=\"run in predictionHistory\" :key=\"run.id\"><td>{{ date(run.completed_at) }}</td><td>{{ run.mode }}</td><td>{{ run.status }}</td><td class=\"gp-mono\">{{ run.id.slice(0, 8) }}</td></tr><tr v-if=\"!predictionHistory.length\"><td colspan=\"4\">Waiting for the first analysis.</td></tr></tbody></table></div></section>\n    <footer class=\"gp-footer\">GREENPULSE AI <span>DynamoDB → sensor validation → saved anomaly model · AI chat runs separately</span></footer>\n  </main>\n</template>\n<script>\nexport default {\n  data() { return { data: {}, connected: false, notice: '', trend: 'air_temp_c', metrics: [\n    {key:'air_temp_c',label:'Air temperature',unit:'°C'},{key:'humidity',label:'Air humidity',unit:'%'},\n    {key:'soil_moisture_l1',label:'Moisture · layer 1',unit:'%'},{key:'soil_moisture_l2',label:'Moisture · layer 2',unit:'%'},\n    {key:'soil_temp_l1_c',label:'Soil temp · layer 1',unit:'°C'},{key:'soil_temp_l2_c',label:'Soil temp · layer 2',unit:'°C'}\n  ]} },\n  computed: {\n    config() { return this.data.config || {} },\n    current() { return this.data.prediction || {} },\n    predictionHistory() { return (this.data.history || []).filter(run => run.mode === 'prediction') },\n    sensor() { return this.current.sensor_report || {} }, latest() { return this.sensor.latest || {} },\n    ml() { return this.current.ml_report || {} },\n    severityClass() { return !this.ml.is_anomaly ? 'gp-green' : this.ml.severity === 'high' ? 'gp-red' : 'gp-amber' },\n    busy() { return !!this.data.running },\n    chartRows() { return (this.sensor.readings || []).map(r => r[this.trend]) },\n    chartValues() { return this.chartRows.filter(v => v != null && Number.isFinite(v)) },\n    chartMin() { return this.chartValues.length ? Math.min(...this.chartValues) : 0 },\n    chartMax() { return this.chartValues.length ? Math.max(...this.chartValues) : 1 },\n    chartPoints() { const span = this.chartMax - this.chartMin; return this.chartRows.map((v,i) => v == null ? null : ({x:this.chartRows.length === 1 ? 300 : i / (this.chartRows.length - 1) * 600, y:span === 0 ? 70 : 130 - (v - this.chartMin) / span * 120})).filter(Boolean) },\n    chartLine() { if (this.chartRows.some(v => v == null)) return ''; return this.chartPoints.map(p => p.x + ',' + p.y).join(' ') }\n  },\n  watch: { msg: { immediate: true, handler(msg) {\n    if (msg?.topic === 'status' && msg.payload?.config) { this.data = msg.payload; this.connected = true; this.notice = '' }\n    if (msg?.topic === 'request-error') { this.notice = msg.payload?.error || 'Request failed'; if(msg.payload?.disconnected) this.connected = false }\n    if (msg?.topic === 'accepted') this.notice = 'Prediction refresh started. Results will appear automatically.'\n  } } },\n  methods: {\n    run(mode) { this.send({topic: mode}); this.notice = 'Requesting analysis…' },\n    sensorValue(v) { return v == null ? '—' : Number(v).toFixed(1) },\n    number(v) { return v == null ? '—' : Number(v).toFixed(4) },\n    date(v) { if(!v) return '—'; return new Date(v).toLocaleString('en-GB', {timeZone:this.config.timezone || 'Asia/Colombo',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'}) }\n  }\n}\n</script>\n<style>\n.gp-tabs{display:flex;gap:8px;margin:0 0 22px;border-bottom:1px solid #dbe6df;padding-bottom:10px}.gp-tabs a{padding:9px 16px;color:#61766c;text-decoration:none;border-radius:7px;font-size:13px;font-weight:600}.gp-tabs .gp-tab-active{background:#217454;color:white}\n\n.gp-shell{--gp-green:#217454;--gp-ink:#183b30;--gp-muted:#61766c;--gp-border:#dbe6df;max-width:1450px;margin:auto;padding:24px 16px 32px;color:var(--gp-ink);font-family:Inter,system-ui,sans-serif;background:#f6f8f5}.gp-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:24px}.gp-eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;color:var(--gp-green)}.gp-heading h1{font-size:clamp(25px,3vw,38px);font-weight:650;letter-spacing:-1px;margin:8px 0}.gp-heading p,.gp-subtle,.gp-meta{font-size:13px;color:var(--gp-muted)}.gp-pill{display:inline-flex;align-items:center;align-self:flex-start;flex:0 0 auto;line-height:1.4;padding:6px 10px;border-radius:20px;font-size:11px;white-space:nowrap;font-weight:600}.gp-green{background:#e0f0e6;color:#216146}.gp-amber{background:#fff0d3;color:#825812}.gp-toolbar{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:18px 20px;background:#edf3ee;border:1px solid var(--gp-border);border-radius:12px;margin-bottom:20px}.gp-toolbar strong,.gp-toolbar span{display:block}.gp-toolbar strong{font-size:14px}.gp-toolbar span{font-size:12px;color:var(--gp-muted);margin-top:4px}.gp-buttons{display:flex;gap:10px}.gp-buttons button{padding:10px 16px;border:1px solid #b7c9bf;border-radius:7px;background:white;color:var(--gp-ink);font-weight:600;font-size:12px}.gp-buttons .gp-primary{background:var(--gp-green);border-color:var(--gp-green);color:white}.gp-buttons button:disabled{opacity:.5;cursor:wait}.gp-buttons button:focus-visible,select:focus-visible{outline:3px solid #81b89a;outline-offset:2px}.gp-alert{padding:12px 16px;background:#fff6e7;border:1px solid #efd6a4;border-radius:8px;color:#72521f;font-size:13px;margin:12px 0}.gp-alert ul{margin:6px 0 0;padding-left:20px}.gp-grid{display:grid;gap:16px}.gp-metrics{grid-template-columns:repeat(6,minmax(0,1fr))}.gp-card{background:#fff;border:1px solid var(--gp-border);border-radius:12px;padding:20px}.gp-label{font-size:12px;color:var(--gp-muted)}.gp-value{font-size:32px;font-weight:650;letter-spacing:-1px;margin:12px 0}.gp-value small{font-size:16px;font-weight:400;margin-left:4px}.gp-card .gp-subtle{font-size:12px;line-height:1.6}.gp-meta{margin:14px 2px 22px}.gp-two{grid-template-columns:1fr 1fr;margin-bottom:16px}.gp-card h2{font-size:17px;font-weight:650;margin:0}.gp-card-heading{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:18px}.gp-result{font-size:26px;font-weight:600;letter-spacing:-.5px;margin:20px 0 10px}.gp-prediction p{font-size:13px;line-height:1.7}.gp-score{display:flex;gap:30px;margin:22px 0}.gp-score span{display:block;font-size:9px;letter-spacing:1px;color:var(--gp-muted)}.gp-score strong{display:block;font-size:22px;margin-top:7px}.gp-meter{position:relative;height:8px;background:#edf3ee;border-radius:4px;overflow:hidden;margin-bottom:15px}.gp-meter div{height:100%;background:var(--gp-green)}.gp-meter span{position:absolute;left:50%;height:100%;top:0;border-left:2px solid #cb963e}.gp-card select{font-size:11px;border:1px solid var(--gp-border);border-radius:6px;padding:6px;max-width:190px;background:white;color:var(--gp-ink)}.gp-chart{height:160px;display:flex;gap:8px;margin-top:20px}.gp-chart svg{width:100%;height:140px;overflow:visible}.gp-chart-scale{display:flex;flex-direction:column;justify-content:space-between;height:140px;font-size:10px;color:var(--gp-muted);min-width:28px}.gp-chart-dates{display:flex;justify-content:space-between;font-size:10px;color:var(--gp-muted);margin:8px 0 15px}.gp-empty{color:var(--gp-muted);height:140px;display:flex;align-items:center;justify-content:center;font-size:13px}.gp-agent{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid #edf1ee}.gp-agent strong{font-size:13px}.gp-agent p{font-size:11px;color:var(--gp-muted);margin:2px 0}.gp-agent-status{margin-left:auto;font-size:11px;color:var(--gp-muted)}.gp-dot{height:9px;width:9px;border-radius:50%;flex-shrink:0}.gp-dot-ok{background:#398966}.gp-dot-pending{background:#cda255}.gp-context{background:#f5f8f5;padding:12px;border-radius:8px;margin-top:16px;font-size:12px}.gp-context p{margin:5px 0;color:var(--gp-muted);line-height:1.5}.gp-action{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #edf1ee}.gp-action-number{background:#edf4ef;color:var(--gp-green);width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:6px;flex-shrink:0;font-size:12px}.gp-priority{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--gp-muted)}.gp-action p{font-size:13px;line-height:1.6;margin:4px 0}.gp-evidence{font-size:12px;line-height:1.6;margin:16px 0}.gp-evidence p{margin:4px 0}.gp-evidence small{color:var(--gp-muted)}.gp-card ul{font-size:12px;padding-left:20px;line-height:1.7}.gp-weather{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:16px}.gp-weather p{font-size:12px;color:var(--gp-muted);margin:8px 0 0}.gp-weather-values{display:flex;flex-direction:column;gap:4px;font-size:12px}.gp-weather-values strong{font-size:22px}.gp-weather-values small{color:var(--gp-muted)}.gp-table-scroll{overflow:auto}.gp-history table{width:100%;border-collapse:collapse;font-size:12px;margin-top:15px}.gp-history th{text-align:left;color:var(--gp-muted);font-weight:500}.gp-history td,.gp-history th{padding:10px 12px;border-bottom:1px solid #edf1ee}.gp-mono{font-family:monospace}.gp-footer{display:flex;justify-content:space-between;margin-top:24px;font-size:10px;letter-spacing:1px;color:var(--gp-muted)}.gp-footer span{letter-spacing:0}@media(max-width:1100px){.gp-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.gp-metrics{grid-template-columns:repeat(2,1fr)}.gp-two{grid-template-columns:1fr}.gp-heading,.gp-toolbar,.gp-weather{align-items:flex-start;flex-direction:column}.gp-buttons{width:100%}.gp-buttons button{flex:1;padding:10px}.gp-card{padding:16px}.gp-footer{gap:10px;flex-direction:column}.gp-heading h1{font-size:28px}}\n\n.gp-red{background:#fde8e7;color:#b42318}.gp-red-text{color:#b42318}.gp-amber-text{color:#825812}.gp-green-text{color:#216146}.gp-red-meter div{background:#c43226}.gp-amber-meter div{background:#b77912}.gp-green-meter div{background:#217454}.gp-score{flex-wrap:wrap;gap:18px 28px}\n</style>\n",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "gp-widget"
    },
    {
        "id": "gp-assistant",
        "type": "ui-template",
        "z": "greenpulse-flow",
        "name": "Plant assistant chat",
        "x": 1100,
        "y": 480,
        "wires": [
            [
                "gp-chat-url"
            ]
        ],
        "group": "gp-ai-group",
        "page": "",
        "ui": "",
        "order": 1,
        "width": "12",
        "height": "0",
        "head": "",
        "format": "<template>\n  <main class=\"gp-shell gp-chat-shell\">\n    <header class=\"gp-heading\"><div><div class=\"gp-eyebrow\">GREENPULSE / PLANT ASSISTANT</div><h1>Ask. Understand. Grow.</h1><p>Plant questions and advice about your stored readings, whenever you need it.</p></div><span class=\"gp-pill\" :class=\"connected ? 'gp-green' : 'gp-amber'\">{{ connected ? 'Backend connected' : 'Waiting for backend' }}</span></header>\n    <nav class=\"gp-tabs\" aria-label=\"Dashboard tabs\"><a href=\"/dashboard/greenhouse\">Prediction</a><a class=\"gp-tab-active\" href=\"/dashboard/assistant\" aria-current=\"page\">AI assistant</a></nav>\n    <div v-if=\"data.config?.demo\" class=\"gp-alert\"><strong>DEMO MODE</strong> — questions are received, but no AI service is called.</div>\n    <div v-if=\"connected && !data.config?.groq_ready && !data.config?.demo\" class=\"gp-alert\">Add GROQ_API_KEY in .env to enable AI answers.</div>\n    <div v-if=\"notice\" class=\"gp-alert\" role=\"status\">{{ notice }}</div>\n    <section class=\"gp-chat-layout\">\n      <article class=\"gp-card gp-conversation\">\n        <div class=\"gp-card-heading\"><h2>Your plant conversation</h2><span class=\"gp-pill gp-green\">Answers on request</span></div>\n        <div v-if=\"!conversation.length\" class=\"gp-chat-empty\"><div class=\"gp-chat-leaf\">🌱</div><h2>What would you like to know?</h2><p>Ask about plant care, greenhouse conditions, or what to check in your sensor readings.</p><div class=\"gp-suggestions\"><button @click=\"suggest('Why do plant leaves turn yellow?', 'general')\" :disabled=\"pending\">Why do leaves turn yellow?</button><button @click=\"suggest('How can I improve greenhouse ventilation?', 'general')\" :disabled=\"pending\">Improve greenhouse ventilation</button><button @click=\"suggest('Explain the latest model result and suggest checks for any anomalies or missing inputs.', 'greenhouse')\" :disabled=\"pending\">Explain my latest readings</button></div></div>\n        <div class=\"gp-messages\" role=\"log\" aria-live=\"polite\"><article v-for=\"turn in conversation\" :key=\"turn.id\" class=\"gp-chat-message\" :class=\"turn.role === 'user' ? 'gp-message-user' : 'gp-message-assistant'\"><div class=\"gp-message-label\">{{ turn.role === 'user' ? 'You' : 'GreenPulse assistant' }}<span v-if=\"turn.scope === 'greenhouse'\"> · Stored readings</span></div><div v-if=\"turn.role === 'assistant'\" class=\"gp-answer\" v-html=\"formatAnswer(turn.content)\"></div><p v-else>{{ turn.content }}</p><small v-if=\"turn.evidence_timestamp\">Evidence recorded: {{ date(turn.evidence_timestamp) }}</small></article><div v-if=\"pending\" class=\"gp-thinking\" role=\"status\">Thinking about your question… Prediction monitoring continues independently.</div></div>\n        <form class=\"gp-chat-form\" @submit.prevent=\"ask\">\n          <fieldset class=\"gp-chat-mode\"><legend>Use</legend><label><input type=\"radio\" v-model=\"scope\" value=\"general\" :disabled=\"pending\"> General plant knowledge</label><label><input type=\"radio\" v-model=\"scope\" value=\"greenhouse\" :disabled=\"pending\"> Greenhouse insights</label></fieldset>\n          <label class=\"gp-question-label\" for=\"gp-plant-question\">Your question</label><textarea id=\"gp-plant-question\" v-model=\"question\" maxlength=\"4000\" rows=\"3\" placeholder=\"Ask a plant question, or describe what you would like to understand…\" :disabled=\"pending\" @keydown.ctrl.enter.prevent=\"ask\"></textarea>\n          <div class=\"gp-chat-submit\"><button class=\"gp-chat-send\" type=\"submit\" :disabled=\"pending || !connected || !question.trim()\">{{ pending ? 'Answering…' : 'Ask assistant' }}</button></div>\n        </form>\n      </article>\n      <aside class=\"gp-card gp-chat-context\" aria-label=\"Greenhouse context\">\n        <div class=\"gp-context-heading\"><h2>Greenhouse context</h2><span class=\"gp-pill\" :class=\"contextReady ? 'gp-green' : 'gp-amber'\">{{ contextStatus }}</span></div>\n        <p>Choose <strong>Greenhouse insights</strong> to include these readings and the prediction with your question.</p>\n        <dl>\n          <div><dt>Prediction</dt><dd>{{ modelSummary }}</dd></div>\n          <div><dt>Last reading</dt><dd>{{ date(contextSensor.latest?.timestamp) }}</dd></div>\n          <div><dt>Crop</dt><dd>{{ data.config?.crop && data.config.crop !== 'unspecified' ? data.config.crop : 'Not set' }}</dd></div>\n          <div><dt>Sensor coverage</dt><dd>{{ availableInputCount }} of 6 measurements available</dd></div>\n        </dl>\n        <div v-if=\"missingInputLabels.length\" class=\"gp-context-missing\"><strong>Missing measurements</strong><p>{{ missingInputLabels.join(', ') }}</p></div>\n      </aside>\n    </section>\n    <footer class=\"gp-footer\">GREENPULSE AI <span>Plant advice for grower review</span></footer>\n  </main>\n</template>\n<script>\nexport default {\n  data() { return {data:{}, connected:false, notice:'', question:'', scope:'general', conversation:[], pending:false, pendingId:null, pendingScope:'general',\n    sensorLabels:{air_temp_c:'Air temperature',humidity:'Air humidity',soil_moisture_l1:'Moisture · layer 1',soil_temp_l1_c:'Soil temperature · layer 1',soil_moisture_l2:'Moisture · layer 2',soil_temp_l2_c:'Soil temperature · layer 2'}\n  } },\n  computed: {\n    contextSensor() { return this.data.prediction?.sensor_report || {} },\n    contextModel() { return this.data.prediction?.ml_report || {} },\n    availableInputCount() { return Object.keys(this.sensorLabels).filter(key => Number.isFinite(this.contextSensor.latest?.[key])).length },\n    missingInputLabels() { return this.contextSensor.latest?.timestamp ? Object.keys(this.sensorLabels).filter(key => !Number.isFinite(this.contextSensor.latest[key])).map(key => this.sensorLabels[key]) : [] },\n    contextReady() { return this.connected && this.contextSensor.status === 'ok' && this.availableInputCount === 6 && this.contextModel.status === 'ok' && !this.contextSensor.warnings?.length },\n    contextStatus() {\n      if(!this.connected) return 'Waiting for connection';\n      if(!this.contextSensor.latest?.timestamp) return 'Waiting for readings';\n      return this.contextReady ? 'Ready to include' : 'Review measurements';\n    },\n    modelSummary() {\n      if(this.contextModel.status === 'ok') return this.contextModel.is_anomaly ? 'Unusual sensor pattern' : 'Normal sensor pattern';\n      if(this.contextModel.status === 'blocked') return 'Needs complete readings';\n      if(this.contextModel.status === 'error') return 'Prediction unavailable';\n      return 'Waiting for prediction';\n    }\n  },\n  watch: { msg: {immediate:true, handler(msg) {\n    if (msg?.topic === 'status' && msg.payload?.config) { this.data=msg.payload; this.connected=true }\n    if (msg?.topic === 'chat-reply' && msg.requestId === this.pendingId) {\n      const reply=msg.payload || {}; this.pending=false; this.pendingId=null;\n      if(reply.answer) { this.conversation.push({id:Date.now() + '-answer',role:'assistant',content:reply.answer,scope:reply.scope,evidence_timestamp:reply.evidence_timestamp}); this.notice='' }\n      else this.notice=reply.error || 'The assistant could not answer. Please retry.';\n    }\n    if (msg?.topic === 'request-error' && (!msg.requestId || msg.requestId === this.pendingId)) { this.notice=msg.payload?.error || 'Request failed'; this.pending=false; this.pendingId=null; if(msg.payload?.disconnected) this.connected=false }\n  }}},\n  methods: {\n    formatAnswer(text) {\n      // Escape all model-provided HTML before adding our own formatting tags.\n      const escape = value => value.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');\n      const inline = value => escape(value).replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>').replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\\*([^*\\n]+)\\*/g,'<em>$1</em>');\n      const lines = String(text).replace(/\\r\\n/g,'\\n').split('\\n');\n      let html='', paragraph=[], list='';\n      const flush = () => { if(paragraph.length) { html+='<p>'+inline(paragraph.join(' '))+'</p>'; paragraph=[] } };\n      const closeList = () => { if(list) { html+='</'+list+'>'; list='' } };\n      for(const line of lines) {\n        const heading=line.match(/^#{1,6}\\s+(.+)$/);\n        const bullet=line.match(/^\\s*(?:[-*+]\\s+|\\d+[.)]\\s+)(.+)$/);\n        if(bullet) {\n          flush(); const kind=/^\\s*\\d/.test(line) ? 'ol' : 'ul';\n          if(list!==kind) { closeList(); html+='<'+kind+'>'; list=kind }\n          html+='<li>'+inline(bullet[1])+'</li>';\n        } else {\n          closeList();\n          if(!line.trim()) flush();\n          else if(heading) { flush(); html+='<h3>'+inline(heading[1])+'</h3>' }\n          else if(/^\\s*([-*_])\\1{2,}\\s*$/.test(line)) { flush(); html+='<hr>' }\n          else paragraph.push(line.trim());\n        }\n      }\n      flush(); closeList(); return html;\n    },\n    suggest(text,scope) { this.question=text; this.scope=scope },\n    ask() {\n      if(this.pending || !this.connected || !this.question.trim()) return;\n      const text=this.question.trim(); const history=this.conversation.slice(-10).map(t=>({role:t.role,content:t.content.slice(0,12000)}));\n      this.pendingId=globalThis.crypto.randomUUID(); this.pending=true; this.pendingScope=this.scope; this.notice='';\n      this.conversation.push({id:this.pendingId,role:'user',content:text,scope:this.scope}); this.question='';\n      this.send({topic:'chat',requestId:this.pendingId,payload:{message:text,scope:this.scope,history}});\n    },\n    date(value) { return value ? new Date(value).toLocaleString('en-GB',{timeZone:this.data.config?.timezone || 'Asia/Colombo',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' }\n  }\n}\n</script>\n<style>\n.gp-chat-shell{--gp-green:#217454;--gp-ink:#183b30;--gp-muted:#61766c;--gp-border:#dbe6df;max-width:1450px;margin:auto;padding:24px 16px 32px;color:var(--gp-ink);font-family:Inter,system-ui,sans-serif;background:#f6f8f5}.gp-chat-shell .gp-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:24px}.gp-chat-shell .gp-eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;color:#217454}.gp-chat-shell h1{font-size:clamp(25px,3vw,38px);font-weight:650;letter-spacing:-1px;margin:8px 0}.gp-chat-shell .gp-heading p{font-size:13px;color:#61766c}.gp-chat-shell .gp-tabs{display:flex;gap:8px;margin:0 0 22px;border-bottom:1px solid #dbe6df;padding-bottom:10px}.gp-chat-shell .gp-tabs a{padding:9px 16px;color:#61766c;text-decoration:none;border-radius:7px;font-size:13px;font-weight:600}.gp-chat-shell .gp-tabs .gp-tab-active{background:#217454;color:white}.gp-chat-shell .gp-card{background:white;border:1px solid #dbe6df;border-radius:12px;padding:24px}.gp-chat-shell .gp-card h2{font-size:18px;font-weight:650;margin:0}.gp-chat-shell .gp-card-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px}.gp-chat-shell .gp-pill{display:inline-flex;align-items:center;align-self:flex-start;flex:0 0 auto;line-height:1.4;padding:6px 10px;border-radius:20px;font-size:11px;white-space:nowrap;font-weight:600}.gp-chat-shell .gp-green{background:#e0f0e6;color:#216146}.gp-chat-shell .gp-amber{background:#fff0d3;color:#825812}.gp-chat-shell .gp-alert{padding:12px 16px;background:#fff6e7;border:1px solid #efd6a4;border-radius:8px;color:#72521f;font-size:13px;margin:12px 0}.gp-chat-layout{display:grid;grid-template-columns:minmax(0,3fr) minmax(260px,1fr);gap:20px;align-items:start}.gp-conversation{min-height:550px}.gp-chat-empty{text-align:center;padding:32px 20px 40px}.gp-chat-leaf{font-size:38px;margin-bottom:15px}.gp-chat-empty p{font-size:13px;color:#61766c;max-width:450px;margin:12px auto 22px;line-height:1.7}.gp-suggestions{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}.gp-suggestions button{padding:9px 12px;border:1px solid #dbe6df;border-radius:8px;font-size:12px;background:#f5f8f5;color:#217454}.gp-messages{display:flex;flex-direction:column;gap:16px;margin:24px 0}.gp-chat-message{padding:16px 18px;border-radius:10px;max-width:94%;border:1px solid #e3eae5}.gp-message-user{align-self:flex-end;background:#eaf4ed}.gp-message-assistant{align-self:flex-start;background:#f9fbf8}.gp-message-label{font-size:11px;font-weight:700;color:#217454;margin-bottom:7px}.gp-message-label span{font-weight:400;color:#61766c}.gp-chat-message p{font-size:14px;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;margin:0}.gp-chat-message small{display:block;font-size:10px;color:#61766c;margin-top:10px}.gp-thinking{font-size:12px;color:#61766c;padding:14px}.gp-chat-form{border-top:1px solid #e3eae5;padding-top:20px}.gp-chat-mode{display:flex;flex-wrap:wrap;gap:16px;border:0;padding:0;margin:0 0 16px}.gp-chat-mode legend{font-size:11px;color:#61766c;margin-bottom:8px}.gp-chat-mode label{font-size:12px;display:flex;gap:6px;align-items:center}.gp-chat-mode input{accent-color:#217454}.gp-question-label{display:block;font-size:12px;font-weight:600;margin-bottom:8px}.gp-chat-form textarea{width:100%;box-sizing:border-box;padding:14px;border:1px solid #bbd0c2;border-radius:9px;resize:vertical;background:white;font:inherit;font-size:13px;color:#183b30}.gp-chat-form textarea:focus-visible{outline:2px solid #81b89a;outline-offset:2px}.gp-chat-submit{display:flex;justify-content:flex-end;gap:12px;align-items:center;margin-top:12px}.gp-chat-send{background:#217454;color:white;border:0;border-radius:7px;padding:11px 18px;font-size:12px;font-weight:600}.gp-chat-send:disabled{opacity:.5}.gp-chat-context p{font-size:12px;line-height:1.8;color:#61766c;margin:15px 0}.gp-chat-context dl{font-size:12px;margin:20px 0}.gp-chat-context dt{color:#61766c;margin-top:16px}.gp-chat-context dd{margin:4px 0 0;font-weight:600;overflow-wrap:anywhere}.gp-chat-shell .gp-footer{display:flex;justify-content:space-between;gap:16px;margin-top:24px;font-size:10px;letter-spacing:1px;color:#61766c}.gp-chat-shell .gp-footer span{letter-spacing:0}@media(max-width:850px){.gp-chat-layout{grid-template-columns:1fr}.gp-chat-context{order:2}.gp-chat-shell .gp-heading{flex-direction:column}.gp-chat-shell .gp-card{padding:18px}.gp-chat-submit{align-items:flex-end}.gp-chat-shell .gp-footer{flex-direction:column}}\n .gp-answer{font-size:14px;line-height:1.7;overflow-wrap:anywhere}.gp-chat-message .gp-answer p{white-space:normal;margin:0 0 12px}.gp-answer p:last-child{margin-bottom:0}.gp-answer h3{font-size:15px;margin:16px 0 8px;font-weight:650}.gp-answer h3:first-child{margin-top:0}.gp-answer ul,.gp-answer ol{padding-left:22px;margin:8px 0 14px}.gp-answer li{margin:6px 0}.gp-answer code{background:#eaf0e9;padding:2px 5px;border-radius:4px}.gp-answer hr{border:0;border-top:1px solid #dbe6df;margin:16px 0}\n\n.gp-chat-shell .gp-chat-context{min-width:0;box-sizing:border-box}\n.gp-context-heading{display:flex;flex-direction:column;align-items:flex-start;gap:12px}\n.gp-chat-context dl{display:grid;gap:0;margin:20px 0 0}\n.gp-chat-context dl>div{padding:14px 0;border-bottom:1px solid #e7eee9}\n.gp-chat-context dl>div:last-child{border-bottom:0;padding-bottom:0}\n.gp-chat-context dt{margin:0;font-size:11px}\n.gp-chat-context dd{margin:6px 0 0;font-size:13px;line-height:1.5}\n.gp-context-missing{margin-top:20px;padding:12px;background:#fff6e7;border-radius:8px;color:#72521f;font-size:11px}\n.gp-context-missing p{margin:6px 0 0;color:inherit;line-height:1.6}\n</style>\n",
        "storeOutMessages": false,
        "passthru": false,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "gp-chat-widget"
    },
    {
        "id": "gp-run-url",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "Request prediction / AI",
        "x": 400,
        "y": 260,
        "wires": [
            [
                "gp-post"
            ]
        ],
        "outputs": 1,
        "func": "if (![\"prediction\", \"assessment\"].includes(msg.topic)) return null;\nmsg.url = (env.get(\"GREENPULSE_API_URL\") || \"http://127.0.0.1:8010\") + \"/api/run\";\nmsg.method=\"POST\"; msg.headers={\"Content-Type\":\"application/json\"}; msg.payload={mode:msg.topic}; return msg;"
    },
    {
        "id": "gp-post",
        "type": "http request",
        "z": "greenpulse-flow",
        "name": "Start background run",
        "x": 640,
        "y": 260,
        "wires": [
            [
                "gp-run-format"
            ]
        ],
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "senderr": false,
        "headers": [],
        "requestTimeout": "15000"
    },
    {
        "id": "gp-run-format",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "Run accepted / error",
        "x": 870,
        "y": 260,
        "wires": [
            [
                "gp-dashboard"
            ],
            [
                "gp-status-url"
            ]
        ],
        "outputs": 2,
        "func": "if(msg.statusCode === 202) { msg.topic=\"accepted\"; return [msg, {payload:null}]; }\nmsg.topic=\"request-error\"; msg.payload={error:msg.statusCode===409 ? \"An analysis is already running.\" : \"Could not start analysis. Check the API.\"}; return [msg,null];"
    },
    {
        "id": "gp-catch",
        "type": "catch",
        "z": "greenpulse-flow",
        "name": "Backend connection errors",
        "x": 630,
        "y": 380,
        "wires": [
            [
                "gp-error"
            ]
        ],
        "scope": [
            "gp-get",
            "gp-post"
        ],
        "uncaught": false
    },
    {
        "id": "gp-error",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "Show disconnected state",
        "x": 870,
        "y": 380,
        "wires": [
            [
                "gp-dashboard",
                "gp-assistant"
            ]
        ],
        "outputs": 1,
        "func": "msg.topic=\"request-error\"; msg.payload={error:\"Backend connection failed. Start scripts/start-dashboard.sh.\",disconnected:true}; return msg;"
    },
    {
        "id": "gp-chat-url",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "Ask plant assistant",
        "x": 400,
        "y": 480,
        "wires": [
            [
                "gp-chat-post"
            ]
        ],
        "outputs": 1,
        "func": "if (msg.topic !== \"chat\" || typeof msg.payload?.message !== \"string\") return null;\nmsg.url = (env.get(\"GREENPULSE_API_URL\") || \"http://127.0.0.1:8010\") + \"/api/chat\";\nmsg.method=\"POST\"; msg.headers={\"Content-Type\":\"application/json\"}; msg.requestTimeout=120000; return msg;"
    },
    {
        "id": "gp-chat-post",
        "type": "http request",
        "z": "greenpulse-flow",
        "name": "Receive AI answer",
        "x": 640,
        "y": 480,
        "wires": [
            [
                "gp-chat-format"
            ]
        ],
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "senderr": false,
        "headers": [],
        "requestTimeout": "120000"
    },
    {
        "id": "gp-chat-format",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "Answer / visible error",
        "x": 870,
        "y": 480,
        "wires": [
            [
                "gp-assistant"
            ]
        ],
        "outputs": 1,
        "func": "msg.topic=\"chat-reply\";\nif(msg.statusCode !== 200) msg.payload={status:\"error\",error:msg.statusCode===409 ? \"The assistant is busy. Try again shortly.\" : \"Could not answer. Check the API connection and question length.\"};\nreturn msg;"
    },
    {
        "id": "gp-chat-catch",
        "type": "catch",
        "z": "greenpulse-flow",
        "name": "Chat connection errors",
        "x": 650,
        "y": 600,
        "wires": [
            [
                "gp-chat-error"
            ]
        ],
        "scope": [
            "gp-chat-post"
        ],
        "uncaught": false
    },
    {
        "id": "gp-chat-error",
        "type": "function",
        "z": "greenpulse-flow",
        "name": "Chat request failed",
        "x": 870,
        "y": 600,
        "wires": [
            [
                "gp-assistant"
            ]
        ],
        "outputs": 1,
        "func": "msg.topic=\"chat-reply\"; msg.payload={status:\"error\",error:\"The assistant request failed or timed out. Please retry.\"}; return msg;"
    }
]