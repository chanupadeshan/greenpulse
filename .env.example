# Groq: matches the model used in the learning labs.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenWeather current outdoor weather. Enter your exact greenhouse coordinates.
OPENWEATHER_API_KEY=
GREENHOUSE_LATITUDE=
GREENHOUSE_LONGITUDE=

# Sensor source: csv, http, or dynamodb. AWS credentials stay outside this file.
SENSOR_SOURCE=csv
SENSOR_CSV_PATH=readings.csv
SENSOR_API_URL=
SENSOR_API_KEY=
SENSOR_TIMEZONE=Asia/Colombo
MAX_SENSOR_AGE_MINUTES=120
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_TABLE=GreenPluse_Sensor_Data
DYNAMODB_DEVICE_ID=
DYNAMODB_READ_LIMIT=120
DYNAMODB_TIMESTAMP_UNIT=s
# Optional JSON mapping from canonical model fields to DynamoDB attribute names.
SENSOR_FIELD_MAP=

# Model and crop context.
ML_MODEL=autoencoder
# Optional custom cutoff for the selected model. Blank uses its trained threshold.
# Higher cutoffs reduce alerts and can miss anomalies; validate using local readings.
ML_THRESHOLD_OVERRIDE=
CROP_NAME=
GROWTH_STAGE=
GROWING_MEDIUM=
REQUEST_TIMEOUT_SECONDS=30

# Continuous prediction monitoring. AI answers run only on submitted questions.
PREDICTION_INTERVAL_SECONDS=60
